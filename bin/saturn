#!/usr/bin/env bash
# saturn: run heavy Julia, R and Python jobs on AWS Fargate from your laptop.
#
# Usage:
#   saturn login [--use-device-code]      # sign in (IAM Identity Center); lasts up to a week
#   saturn connect                        # workspace, satellite data and database on this laptop
#   saturn disconnect
#   saturn status
#   saturn run [-e NAME=VALUE ...] path/to/script.jl|.R|.py [args...]
#   saturn logs <task-id>                 # follow a job's output again
#   saturn stop <task-id>
#   saturn list                           # running jobs
#   saturn costs                          # spending per month and person
#   saturn docs                           # open the user guide in your browser
#   saturn cost <task-id>                 # (re)compute one job's cost
#
# After `saturn connect`, this laptop has the same environment variables as a job
# (WORKSPACE, MY_WORKSPACE, SATELLITE, DATASETS, DATA_BUCKET, AWS_REGION, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD),
# pointing at the local mounts and the database tunnel, so the same code runs in both.
# They're kept in ~/.config/saturn-v/env; `eval "$(saturn connect)"` also sets them in
# the current terminal.
#
# The script path is relative to the workspace (~/aws/workspace on your laptop,
# /workspace in the job). Julia: packages come from the nearest Project.toml. R: from
# renv.lock in the script's folder, if there is one. Python: from the nearest
# pyproject.toml, a requirements.txt next to the script, or the script's own header
# (installed with uv, afresh in each job). Julia and R packages are cached between runs.
#
# -e sets an environment variable inside the job (repeatable).
# Size and options (env vars): CPU=16384 MEMORY=65536 (default 4 vCPU / 16 GB; up to
# 32768 / 249856), SPOT=1 (~70% cheaper, can be interrupted), DETACH=1 (return at once).
# R jobs run on the R version (major.minor) of the renv.lock next to the script, or the
# newest available; R_VERSION=4.5 chooses one.
# Ctrl-C stops following a job; the job keeps running. Your laptop can sleep meanwhile.
#
# Sign in first with: saturn login   (IAM users, until the switch: aws login --profile aws-server)
set -euo pipefail

SATURN_HOME=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)
STATE_DIR="$HOME/.config/saturn-v"
export AWS_DEFAULT_REGION="${SATURN_REGION:-ap-south-1}"

# Signed in through IAM Identity Center (`saturn login`): profile saturn-v. IAM users
# (the sign-in before Identity Center) use `aws login` and profile aws-server.
SSO_PROFILE=saturn-v SSO_SESSION=saturn-v
# The access portal people sign in at, and the region Identity Center lives in (not
# secrets; the jobs and data are in AWS_DEFAULT_REGION).
SSO_START_URL="${SATURN_SSO_START_URL:-https://d-9067ac7cfe.awsapps.com/start}"
SSO_REGION="${SATURN_SSO_REGION:-us-east-1}"
if [[ -n ${SATURN_PROFILE:-} ]]; then
  AWS_PROFILE=$SATURN_PROFILE
elif [[ ${1:-} == login ]] || env -u AWS_PROFILE aws configure get sso_session --profile "$SSO_PROFILE" >/dev/null 2>&1; then
  AWS_PROFILE=$SSO_PROFILE
else
  AWS_PROFILE=aws-server
fi
export AWS_PROFILE
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
mkdir -p "$STATE_DIR"

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
[[ ${1:-} =~ ^(login|connect|disconnect|status|run|logs|stop|list|cost|costs|docs|__tunnel-keeper)$ ]] || usage

die() { echo "saturn: $*" >&2; exit 1; }

# The signed-in AWS user name, and their folder in the workspace (lower case, e.g. sanjuktha.athreya).
# With Identity Center the name can be an email address; the part before the @ is used.
me() { aws sts get-caller-identity --query Arn --output text | sed 's|.*/||; s|@.*||'; }
my_folder() { me | tr '[:upper:]' '[:lower:]'; }

uses_sso() { [[ $AWS_PROFILE == "$SSO_PROFILE" ]]; }
sign_in_command() { if uses_sso; then echo "saturn login"; else echo "aws login --profile $AWS_PROFILE"; fi; }

# --- Sign-in (IAM Identity Center) ----------------------------------------------------
# Signs in at the access portal (browser, or a code on another device with
# --use-device-code), then writes the saturn-v profile for the role you have:
# SaturnUser, or Admin for admins (also as profile saturn-v-admin, which ./tf uses).
do_login() {
  local config="${AWS_CONFIG_FILE:-$HOME/.aws/config}" token account roles role
  [[ -n $SSO_START_URL ]] || die "set SATURN_SSO_START_URL to your AWS access portal (ask an admin)"
  mkdir -p "$(dirname "$config")" && touch "$config"
  if ! grep -q "^\[sso-session $SSO_SESSION\]" "$config"; then
    printf '\n[sso-session %s]\nsso_start_url = %s\nsso_region = %s\nsso_registration_scopes = sso:account:access\n' \
      "$SSO_SESSION" "$SSO_START_URL" "$SSO_REGION" >>"$config"
  fi
  env -u AWS_PROFILE aws sso login --sso-session "$SSO_SESSION" "$@" || exit 1

  token=$(python3 -c 'import hashlib, json, os, sys
f = os.path.expanduser("~/.aws/sso/cache/%s.json" % hashlib.sha1(sys.argv[1].encode()).hexdigest())
print(json.load(open(f))["accessToken"])' "$SSO_SESSION")
  account=$(env -u AWS_PROFILE aws sso list-accounts --region "$SSO_REGION" --access-token "$token" --query 'accountList[0].accountId' --output text)
  roles=$(env -u AWS_PROFILE aws sso list-account-roles --region "$SSO_REGION" --access-token "$token" --account-id "$account" --query 'roleList[].roleName' --output text | tr '\t' ' ')
  [[ -n $roles ]] || die "signed in, but you have no access to the AWS account yet. Ask an admin to add you to saturn-v-users."

  set_profile() { # profile role
    env -u AWS_PROFILE aws configure set sso_session "$SSO_SESSION" --profile "$1"
    env -u AWS_PROFILE aws configure set sso_account_id "$account" --profile "$1"
    env -u AWS_PROFILE aws configure set sso_role_name "$2" --profile "$1"
    env -u AWS_PROFILE aws configure set region "$AWS_DEFAULT_REGION" --profile "$1"
  }
  if [[ " $roles " == *" SaturnUser "* ]]; then role=SaturnUser; else role=$(echo "$roles" | awk '{print $1}'); fi
  set_profile "$SSO_PROFILE" "$role"
  [[ " $roles " == *" Admin "* ]] && set_profile "$SSO_PROFILE-admin" Admin
  echo "Signed in as $(me) ($role). Next: saturn connect"
}

# --- Deployment settings ---------------------------------------------------------
# Published by xKDR/AWS-Server as the SSM parameter /saturn-v/deployment on every
# apply. Fetched on each run, with the last copy as a fallback.
deployment() {
  local cache="$STATE_DIR/deployment.json" fresh
  if fresh=$(aws ssm get-parameter --name /saturn-v/deployment --query Parameter.Value --output text 2>/dev/null); then
    printf '%s' "$fresh" >"$cache"
  elif ! aws sts get-caller-identity >/dev/null 2>&1; then
    die "not signed in to AWS. Run: $(sign_in_command)"
  elif [[ ! -s $cache ]]; then
    die "can't read the deployment settings (/saturn-v/deployment). Ask an admin to add you to the team."
  fi
  cat "$cache"
}
DEPLOYMENT=
cfg() { # cfg key [subkey...]
  [[ -n $DEPLOYMENT ]] || DEPLOYMENT=$(deployment)
  python3 -c '
import json, sys
v = json.loads(sys.argv[1])
for k in sys.argv[2:]: v = v[k]
print(",".join(map(str, v)) if isinstance(v, list) else v)' "$DEPLOYMENT" "$@"
}

# --- Jobs ------------------------------------------------------------------------

language_of() {
  case "$1" in
  *.jl) echo julia ;;
  *.R | *.r) echo r ;;
  *.py) echo python ;;
  *) die "don't know how to run $1 (expected .jl, .R or .py)" ;;
  esac
}

task_json() { aws ecs describe-tasks --cluster "$(cfg cluster)" --tasks "$1" --query 'tasks[0]' --output json; }
task_field() { aws ecs describe-tasks --cluster "$(cfg cluster)" --tasks "$1" --query "tasks[0].$2" --output text; }

follow() {
  local task_id=$1 container status code reason
  container=$(task_field "$task_id" 'containers[0].name')
  if [[ $container == None ]]; then
    echo "== job $task_id finished some time ago; AWS no longer has its details (its cost is in saturn costs)"
    return 1
  fi
  echo "Waiting for job $task_id to start..."
  # "None": AWS has forgotten the task, which it does about an hour after it stops.
  until [[ $(task_field "$task_id" lastStatus) =~ ^(RUNNING|DEACTIVATING|STOPPING|DEPROVISIONING|STOPPED|None)$ ]]; do
    sleep 5
  done

  aws logs tail "$(cfg log_group)" --log-stream-names "$container/$container/$task_id" --follow --format short &
  local tail_pid=$!
  disown $tail_pid # no "Terminated" notice when we kill it below
  trap 'kill $tail_pid 2>/dev/null; echo; echo "Stopped following; job $task_id is still running (saturn logs $task_id)."; exit 130' INT

  until [[ $(task_field "$task_id" lastStatus) =~ ^(STOPPED|None)$ ]]; do
    sleep 15
  done
  sleep 30 # CloudWatch can take a while to deliver the last lines
  kill $tail_pid 2>/dev/null || true
  trap - INT

  code=$(task_field "$task_id" 'containers[0].exitCode')
  if [[ $code == None ]]; then
    echo "== job finished some time ago; AWS no longer has its details (its cost is in saturn costs)"
    return 1
  fi
  reason=$(task_field "$task_id" stoppedReason)
  echo "== job stopped: exit code $code ($reason)"
  record_cost "$task_id" || echo "(couldn't record the cost; retry with: saturn cost $task_id)"
  [[ $code == 0 ]]
}

# Fargate list prices for this region, cached for a day.
prices() {
  local cache="$STATE_DIR/fargate-prices-$AWS_DEFAULT_REGION.json" prefix
  if [[ ! -s $cache || -n $(find "$cache" -mtime +1 2>/dev/null) ]]; then
    # Billing-code prefix AWS uses for the region in usage types (e.g. APS3-Fargate-GB-Hours).
    case $AWS_DEFAULT_REGION in
    ap-south-1) prefix=APS3 ;; us-east-1) prefix=USE1 ;; eu-central-1) prefix=EUC1 ;;
    *) die "add $AWS_DEFAULT_REGION's billing prefix to prices() in $0" ;;
    esac
    for u in Fargate-vCPU-Hours:perCPU Fargate-GB-Hours Fargate-EphemeralStorage-GB-Hours; do
      aws pricing get-products --region ap-south-1 --service-code AmazonECS \
        --filters "Type=TERM_MATCH,Field=usagetype,Value=$prefix-$u" --output json |
        python3 -c 'import json, sys
L = json.load(sys.stdin)["PriceList"]
print(sys.argv[1], [d["pricePerUnit"]["USD"] for p in L for t in json.loads(p)["terms"]["OnDemand"].values() for d in t["priceDimensions"].values()][0])' "$u"
    done | python3 -c 'import json, sys; print(json.dumps(dict(l.split() for l in sys.stdin)))' >"$cache.tmp"
    mv "$cache.tmp" "$cache"
  fi
  cat "$cache"
}

# Fargate bills from the start of the image pull until the task stops, per second,
# with a one-minute minimum; ephemeral storage only above the free 20 GB.
# ECS forgets stopped tasks after about an hour. If nobody was following the job then,
# the details saved at launch (costs/pending/) and the time of the job's last log line
# are used instead, and the record is marked approximate.
record_cost() {
  local task_id=$1 task approx=0 bucket record
  bucket=$(cfg workspace_bucket)
  task=$(aws ecs describe-tasks --cluster "$(cfg cluster)" --tasks "$task_id" --output json |
    python3 -c 'import json, sys; t = json.load(sys.stdin)["tasks"]; print(json.dumps(t[0]) if t else "")')
  if [[ -z $task ]]; then
    local pending container last
    pending=$(aws s3 cp "s3://$bucket/costs/pending/$task_id.json" - 2>/dev/null) || { echo "no record of job $task_id" >&2; return 1; }
    container=$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["containers"][0]["name"])' "$pending")
    last=$(aws logs get-log-events --log-group-name "$(cfg log_group)" --log-stream-name "$container/$container/$task_id" \
      --no-start-from-head --limit 1 --query 'events[0].timestamp' --output text)
    task=$(python3 -c '
import json, sys, datetime as dt
t = json.loads(sys.argv[1])
t["stoppedAt"] = dt.datetime.fromtimestamp(int(sys.argv[2]) / 1000, dt.timezone.utc).isoformat()
print(json.dumps(t))' "$pending" "$last")
    approx=1
  fi
  [[ $(python3 -c 'import json, sys; print(json.loads(sys.argv[1]).get("lastStatus"))' "$task") == STOPPED || $approx == 1 ]] ||
    { echo "job $task_id is still running" >&2; return 1; }
  record=$(python3 -c '
import json, sys, math, datetime as dt
task, prices, who, approx = json.loads(sys.argv[1]), json.loads(sys.argv[2]), sys.argv[3], sys.argv[4] == "1"
t = lambda k: dt.datetime.fromisoformat(task[k]) if task.get(k) else None
start = t("pullStartedAt") or t("startedAt") or t("createdAt")
stop = t("stoppedAt")
seconds = max(60, math.ceil((stop - start).total_seconds()))
hours = seconds / 3600
vcpu, gb = int(task["cpu"]) / 1024, int(task["memory"]) / 1024
disk = task.get("ephemeralStorage", {}).get("sizeInGiB", 20)
spot = task.get("capacityProviderName") == "FARGATE_SPOT"
cmd = task.get("overrides", {}).get("containerOverrides", [{}])[0].get("command", [])
cost = {
    "vcpu": round(vcpu * hours * float(prices["Fargate-vCPU-Hours:perCPU"]), 4),
    "memory": round(gb * hours * float(prices["Fargate-GB-Hours"]), 4),
    "storage": round(max(0, disk - 20) * hours * float(prices["Fargate-EphemeralStorage-GB-Hours"]), 4),
}
note = ["on-demand list price" + ("; Fargate Spot is billed less" if spot else "")]
if approx: note.append("approximate: end time from the last log line")
print(json.dumps({
    "task_id": task["taskArn"].rsplit("/", 1)[1], "who": who, "script": cmd[4] if len(cmd) > 4 else "",
    "language": task["containers"][0]["name"],
    "task_definition": task.get("taskDefinitionArn", "").rsplit("/", 1)[-1],
    "started": start.isoformat(), "stopped": stop.isoformat(), "billed_seconds": seconds,
    "vcpu": vcpu, "memory_gb": gb, "storage_gb": disk, "spot": spot,
    "exit_code": task["containers"][0].get("exitCode"),
    "cost_usd": cost, "total_usd": round(sum(cost.values()), 4), "note": "; ".join(note),
}))' "$task" "$(prices)" "$(aws sts get-caller-identity --query Arn --output text | sed 's|.*/||')" "$approx")
  python3 -c '
import json, sys
r = json.loads(sys.argv[1]); c = r["cost_usd"]
money = lambda x: ("$%.3f" if x < 0.1 else "$%.2f") % x
print("== cost: {} for {:.1f} min at {:g} vCPU / {:g} GB (vCPU {}, memory {}, disk {}; {})".format(
    money(r["total_usd"]), r["billed_seconds"] / 60, r["vcpu"], r["memory_gb"],
    money(c["vcpu"]), money(c["memory"]), money(c["storage"]), r["note"]))' "$record"
  echo "$record" | aws s3 cp - "s3://$bucket/costs/tasks/$(date -u +%Y-%m)/$task_id.json" --only-show-errors
  aws s3 rm --only-show-errors "s3://$bucket/costs/pending/$task_id.json" || true
}

# The R task definition for a script: the R version its renv.lock was made with (read
# from S3, as the job will see it), R_VERSION if set, or the newest available.
r_task_definition() {
  local script=$1 lock version
  version=${R_VERSION:-}
  if [[ -z $version ]] && lock=$(aws s3 cp "s3://$(cfg workspace_bucket)/$(dirname "$script")/renv.lock" - 2>/dev/null); then
    version=$(python3 -c 'import json, sys; print(".".join(json.loads(sys.argv[1])["R"]["Version"].split(".")[:2]))' "$lock")
    echo "renv.lock was made with R $version" >&2
  fi
  python3 -c '
import json, sys
r = json.loads(sys.argv[1])["languages"]["r"]
version, versions = sys.argv[2], r.get("versions", {})
if not version:
    print(r["task_definition"])
elif version in versions:
    print(versions[version])
else:
    sys.exit("saturn: R %s is not available on AWS (available: %s). "
             "Make the renv.lock with one of those, or choose one with R_VERSION=..." % (version, ", ".join(sorted(versions))))' "$DEPLOYMENT" "$version"
}

run_job() {
  local envs=() lang launcher overrides capacity task_arn task_id task_definition
  while [[ ${1:-} == -e ]]; do
    [[ ${2:-} == *=* ]] || die "-e needs NAME=VALUE"
    envs+=("$2")
    shift 2
  done
  [[ $# -ge 1 ]] || die "usage: saturn run [-e NAME=VALUE ...] path/to/script.jl|.R|.py [args...]"
  lang=$(language_of "$1")
  [[ -n $DEPLOYMENT ]] || DEPLOYMENT=$(deployment)
  if [[ $lang == r ]]; then
    task_definition=$(r_task_definition "$1") || exit 1
  else
    task_definition=$(cfg languages "$lang" task_definition)
  fi
  launcher=$(cat "$SATURN_HOME/lib/launch-$lang.sh")

  local helper="$SATURN_HOME/lib/saturn.R"
  [[ $lang == julia ]] && helper="$SATURN_HOME/lib/saturn.jl"
  [[ $lang == python ]] && helper="$SATURN_HOME/lib/saturn.py"
  envs=("MY_WORKSPACE=/workspace/$(my_folder)" ${envs[@]+"${envs[@]}"})
  overrides=$(ENVS=$(printf '%s\n' ${envs[@]+"${envs[@]}"}) HELPER_FILE=$helper python3 -c '
import json, os, sys
container, launcher, args = sys.argv[1], sys.argv[2], sys.argv[3:]
env = [dict(zip(("name", "value"), l.split("=", 1))) for l in os.environ["ENVS"].splitlines() if l]
env.append({"name": "SATURN_HELPER", "value": open(os.environ["HELPER_FILE"]).read()})
o = {"containerOverrides": [{"name": container, "command": ["bash", "-c", launcher, container] + args, "environment": env}]}
if os.environ.get("CPU"): o["cpu"] = os.environ["CPU"]
if os.environ.get("MEMORY"): o["memory"] = os.environ["MEMORY"]
print(json.dumps(o))' "$(cfg languages "$lang" container)" "$launcher" "$@")

  if [[ ${SPOT:-0} == 1 ]]; then
    capacity=(--capacity-provider-strategy capacityProvider=FARGATE_SPOT,weight=1)
  else
    capacity=(--launch-type FARGATE)
  fi

  # The subnets are public with no NAT, so the job needs a public IP to pull its image
  # and packages. No inbound ports are open.
  task_arn=$(aws ecs run-task --cluster "$(cfg cluster)" "${capacity[@]}" --started-by "$(me | cut -c1-36)" \
    --task-definition "$task_definition" \
    --network-configuration "awsvpcConfiguration={subnets=[$(cfg subnets)],securityGroups=[$(cfg security_group)],assignPublicIp=ENABLED}" \
    --overrides "$overrides" \
    --query 'tasks[0].taskArn' --output text)
  task_id=${task_arn##*/}
  [[ -n $task_id && $task_id != None ]] || die "AWS didn't start the job"
  echo "Started job $task_id"
  # Saved so the cost can still be worked out if nobody is following the job when it ends.
  task_json "$task_id" | aws s3 cp - "s3://$(cfg workspace_bucket)/costs/pending/$task_id.json" --only-show-errors

  if [[ ${DETACH:-0} == 1 ]]; then
    echo "Follow with: saturn logs $task_id"
  else
    follow "$task_id"
  fi
}

show_costs() {
  local bucket dir="$STATE_DIR/costs"
  bucket=$(cfg workspace_bucket)
  # First record any finished jobs that nobody was following when they ended.
  for pending in $(aws s3 ls "s3://$bucket/costs/pending/" | awk '{print $4}'); do
    record_cost "${pending%.json}" 2>/dev/null || true
  done
  aws s3 sync --only-show-errors "s3://$bucket/costs/tasks/" "$dir/"
  python3 -c '
import json, glob, collections, sys
rows = [json.load(open(f)) for f in glob.glob(sys.argv[1] + "/**/*.json", recursive=True)]
by = collections.defaultdict(lambda: [0, 0.0, 0.0])
for r in rows:
    k = (r["started"][:7], r["who"]); by[k][0] += 1; by[k][1] += r["billed_seconds"] / 3600; by[k][2] += r["total_usd"]
print("{:8} {:16} {:>6} {:>8} {:>9}".format("month", "who", "jobs", "hours", "USD"))
for (m, w), (n, h, c) in sorted(by.items()): print("{:8} {:16} {:6} {:8.2f} {:9.2f}".format(m, w, n, h, c))
print("{:25} {:6} {:8.2f} {:9.2f}".format("total", len(rows), sum(v[1] for v in by.values()), sum(v[2] for v in by.values())))' "$dir"
}

# --- Laptop mounts (macOS) ---------------------------------------------------------

WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/aws/workspace}"
SATELLITE_DIR="${SATELLITE_DIR:-$HOME/aws/satellite}"
DATASETS_DIR="${DATASETS_DIR:-$HOME/aws/datasets}"
VFS_FLAGS=(--vfs-cache-mode full --vfs-cache-max-size 20G --dir-cache-time 30s --log-level NOTICE)

is_mounted() { mount | grep -q " on $1 "; }
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# The mounts use an access key on your own account, which `saturn connect` creates once
# and keeps in $STATE_DIR/mount-credentials, so they keep working after the 12-hour
# `aws login` expires. AWS only lets such keys use the buckets, and removing you from
# the saturn-v-users group disables it. IAM allows two keys per user, so two computers;
# saturn only ever deletes the key it made on this computer.
with_mount_key() {
  AWS_SHARED_CREDENTIALS_FILE="$STATE_DIR/mount-credentials" AWS_CONFIG_FILE=/dev/null AWS_PROFILE=rclone "$@"
}

mount_key_works() { with_mount_key aws s3api head-bucket --bucket "$(cfg workspace_bucket)" >/dev/null 2>&1; }

# A key that can do more than the buckets (e.g. an admin's, outside saturn-v-users)
# must not sit on a laptop: delete it and mount with the sign-in instead.
mount_key_too_powerful() {
  local id
  with_mount_key aws iam list-access-keys >/dev/null 2>&1 || return 1
  id=$(sed -n 's/^aws_access_key_id = //p' "$STATE_DIR/mount-credentials")
  echo "(your account isn't limited like saturn-v-users, so no mount key is kept for it)"
  aws iam delete-access-key --user-name "$(me)" --access-key-id "$id"
  rm -f "$STATE_DIR/mount-credentials"
}

make_mount_key() {
  local user old keys key
  user=$(me) || return 1
  old=$(sed -n 's/^aws_access_key_id = //p' "$STATE_DIR/mount-credentials" 2>/dev/null)
  [[ -n $old ]] && aws iam delete-access-key --user-name "$user" --access-key-id "$old" 2>/dev/null
  keys=($(aws iam list-access-keys --user-name "$user" \
    --query 'sort_by(AccessKeyMetadata, &CreateDate)[].AccessKeyId' --output text)) || return 1
  if ((${#keys[@]} >= 2)); then
    echo "(you already have two access keys, the most AWS allows; delete one you no longer use"
    echo " under Security credentials in the AWS console, then run saturn connect again)"
    return 1
  fi
  key=($(aws iam create-access-key --user-name "$user" \
    --query 'AccessKey.[AccessKeyId, SecretAccessKey]' --output text)) || return 1
  (
    umask 077
    printf '[rclone]\naws_access_key_id = %s\naws_secret_access_key = %s\n' "${key[0]}" "${key[1]}" \
      >"$STATE_DIR/mount-credentials"
  )
  # A new key takes a few seconds to work everywhere in AWS.
  for _ in 1 2 3 4 5 6; do mount_key_works && return 0; sleep 5; done
}

use_rclone_credentials() {
  local real_config="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
  # Identity Center sign-ins renew their keys for the whole session: no stored key needed.
  if ! uses_sso && { mount_key_works || make_mount_key; } && ! mount_key_too_powerful; then
    : >"$STATE_DIR/rclone-aws-config"
    export AWS_SHARED_CREDENTIALS_FILE="$STATE_DIR/mount-credentials"
  else
    uses_sso || echo "(no mount key; the mounts use your sign-in and pause when it expires)"
    cat >"$STATE_DIR/rclone-aws-config" <<EOF
[profile rclone]
credential_process = /usr/bin/env AWS_CONFIG_FILE=$real_config $(command -v aws) configure export-credentials --profile $AWS_PROFILE --format process
EOF
  fi
  export AWS_CONFIG_FILE="$STATE_DIR/rclone-aws-config" AWS_PROFILE=rclone
  export RCLONE_CONFIG_S3_TYPE=s3 RCLONE_CONFIG_S3_PROVIDER=AWS RCLONE_CONFIG_S3_ENV_AUTH=true
  export RCLONE_CONFIG_S3_REGION=$AWS_DEFAULT_REGION
  # S3 has no folders, only files; without a marker, an empty folder made on the laptop
  # never reaches S3 (or the jobs). Jobs (S3 Files) read "dir/" markers as folders.
  export RCLONE_CONFIG_S3_DIRECTORY_MARKERS=true
}

# Read-write, with working file locks: rclone serves NFS on localhost and we mount it
# ourselves with `locallocks`, so SVN and SQLite work in the folder. `hard` makes file
# operations wait (not fail) while S3 is unreachable, e.g. after the sign-in expires.
mount_workspace() {
  local bucket=$1 port=${WORKSPACE_PORT:-52049}
  if is_mounted "$WORKSPACE_DIR"; then echo "$WORKSPACE_DIR already mounted"; return; fi
  mkdir -p "$WORKSPACE_DIR"
  if [[ $(uname) == Linux ]]; then
    # FUSE: the kernel handles file locks itself, so SVN and SQLite work here too.
    rclone mount "s3:$bucket" "$WORKSPACE_DIR" --daemon "${VFS_FLAGS[@]}" --vfs-links \
      --log-file "$STATE_DIR/rclone-workspace.log"
    echo "Mounted the workspace at $WORKSPACE_DIR"
    return
  fi
  # --vfs-links: S3 has no symlinks, so each is stored as a small "<name>.rclonelink" file.
  nohup rclone serve nfs "s3:$bucket" --addr "127.0.0.1:$port" "${VFS_FLAGS[@]}" --vfs-links \
    --log-file "$STATE_DIR/rclone-workspace.log" >/dev/null 2>&1 &
  echo $! >"$STATE_DIR/rclone-workspace.pid"
  until port_open "$port"; do sleep 0.5; done
  mount -t nfs -o "port=$port,mountport=$port,tcp,vers=3,locallocks,hard,intr" "127.0.0.1:/" "$WORKSPACE_DIR"
  echo "Mounted the workspace at $WORKSPACE_DIR"
}

# Read-only mounts: mount_readonly bucket dir name
mount_readonly() {
  local bucket=$1 dir=$2 name=$3
  if is_mounted "$dir"; then echo "$dir already mounted"; return; fi
  mkdir -p "$dir"
  local how=nfsmount
  [[ $(uname) == Linux ]] && how=mount
  rclone "$how" "s3:$bucket" "$dir" --daemon --volname "$name" --read-only "${VFS_FLAGS[@]}" \
    --log-file "$STATE_DIR/rclone-$name.log"
  echo "Mounted $name at $dir (read-only)"
}

# macOS stores extended attributes as ._* files on network drives; keep them out of SVN.
svn_ignore_appledouble() {
  local svncfg="$HOME/.subversion/config"
  [[ -f $svncfg ]] || return 0
  grep -q '^global-ignores.*\._\*' "$svncfg" && return 0
  python3 -c '
import re, sys
path = sys.argv[1]; s = open(path).read()
if re.search(r"^global-ignores", s, re.M):
    s = re.sub(r"^global-ignores = ", "global-ignores = ._* .DS_Store ", s, count=1, flags=re.M)
else:
    s = re.sub(r"^\[miscellany\]$", "[miscellany]\nglobal-ignores = ._* .DS_Store *.o *.lo *.la *.al .libs *.so *.so.[0-9]* *.a *.pyc *.pyo __pycache__ *.rej *~ #*# .#* .*.swp", s, count=1, flags=re.M)
open(path, "w").write(s)' "$svncfg"
}

do_mount() {
  command -v rclone >/dev/null || die "install rclone first (see the README's setup)"
  if [[ $(uname) == Linux ]]; then
    command -v fusermount3 >/dev/null || command -v fusermount >/dev/null ||
      die "install FUSE first: sudo apt install fuse3 (Debian/Ubuntu) or sudo dnf install fuse3 (Fedora)"
  elif [[ $(uname) != Darwin ]]; then
    die "mounting works on macOS and Linux only"
  fi
  local workspace data datasets
  workspace=$(cfg workspace_bucket)
  data=$(cfg data_bucket)
  datasets=$(cfg datasets_bucket)
  # In a subshell: the mount key's settings must apply to rclone only, not to the
  # commands that follow (which run as you).
  (
    use_rclone_credentials
    mount_workspace "$workspace"
    mount_readonly "$data" "$SATELLITE_DIR" satellite
    mount_readonly "$datasets" "$DATASETS_DIR" datasets
  ) || exit 1
  svn_ignore_appledouble
}

do_unmount() {
  for dir in "$WORKSPACE_DIR" "$SATELLITE_DIR" "$DATASETS_DIR"; do
    if is_mounted "$dir"; then
      if [[ $(uname) == Linux ]]; then
        fusermount3 -u "$dir" 2>/dev/null || fusermount -u "$dir" || die "$dir is busy: cd out of it (and close files there) first"
      else
        umount "$dir" || die "$dir is busy: cd out of it (and close files there) first"
      fi
      echo "Unmounted $dir"
    fi
  done
  [[ -f $STATE_DIR/rclone-workspace.pid ]] && kill "$(cat "$STATE_DIR/rclone-workspace.pid")" 2>/dev/null
  rm -f "$STATE_DIR/rclone-workspace.pid"
  pkill -f "rclone (nfsmount|serve nfs|mount) s3:" || true
}

# --- Database tunnel ---------------------------------------------------------------
# Through the EC2 server (SSM port forwarding), which is started if it's stopped.
# Runs in the background; its pid is kept so `saturn disconnect` can stop it.

# The local port: DB_LOCAL_PORT if set (remembered for later commands), else the last one used, else 3306.
DB_LOCAL_PORT="${DB_LOCAL_PORT:-$(cat "$STATE_DIR/db-port" 2>/dev/null || echo 3306)}"
our_tunnel() { [[ -f $STATE_DIR/tunnel.pid ]] && kill -0 "$(cat "$STATE_DIR/tunnel.pid")" 2>/dev/null; }

# Is the tunnel really working? The database sends a greeting as soon as a connection
# opens; a tunnel that's broken at the far end accepts the connection but stays silent.
tunnel_alive() {
  perl -MIO::Socket::INET -e '
    my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $ARGV[0], Timeout => 5) or exit 1;
    local $SIG{ALRM} = sub { exit 1 }; alarm 8;
    sysread($s, my $buf, 4) or exit 1; exit 0' "$DB_LOCAL_PORT"
}

start_tunnel() {
  local instance host port state
  if our_tunnel; then
    if tunnel_alive; then echo "Database tunnel already open on 127.0.0.1:$DB_LOCAL_PORT"; return; fi
    echo "The database tunnel stopped answering; reopening it"
    stop_tunnel
  elif port_open "$DB_LOCAL_PORT"; then
    die "port $DB_LOCAL_PORT is in use by something else (a local MySQL?). Use: DB_LOCAL_PORT=13306 saturn connect"
  fi
  command -v session-manager-plugin >/dev/null || die "install the Session Manager plugin first: brew install --cask session-manager-plugin"
  instance=$(cfg instance_id)
  host=$(cfg db_host)
  port=$(cfg db_port)
  state=$(aws ec2 describe-instances --instance-ids "$instance" --query 'Reservations[0].Instances[0].State.Name' --output text)
  if [[ $state != running ]]; then
    echo "Starting the database tunnel server (was $state)..."
    [[ $state == stopping ]] && aws ec2 wait instance-stopped --instance-ids "$instance"
    aws ec2 start-instances --instance-ids "$instance" >/dev/null
    aws ec2 wait instance-running --instance-ids "$instance"
  fi
  until [[ $(aws ssm describe-instance-information --filters "Key=InstanceIds,Values=$instance" \
    --query 'InstanceInformationList[0].PingStatus' --output text) == Online ]]; do
    echo "Waiting for the tunnel server..."
    sleep 10
  done
  nohup aws ssm start-session --target "$instance" \
    --document-name AWS-StartPortForwardingSessionToRemoteHost \
    --parameters "{\"host\":[\"$host\"],\"portNumber\":[\"$port\"],\"localPortNumber\":[\"$DB_LOCAL_PORT\"]}" \
    >"$STATE_DIR/tunnel.log" 2>&1 </dev/null &
  echo $! >"$STATE_DIR/tunnel.pid"
  echo "$DB_LOCAL_PORT" >"$STATE_DIR/db-port"
  disown
  for _ in $(seq 60); do port_open "$DB_LOCAL_PORT" && break; sleep 1; done
  port_open "$DB_LOCAL_PORT" || die "the database tunnel didn't open; see $STATE_DIR/tunnel.log"
  echo "Database tunnel open on 127.0.0.1:$DB_LOCAL_PORT"
}

# Runs in the background while connected: every 4 minutes it checks the tunnel, which
# also counts as activity (SSM closes idle sessions after ~20 minutes), and reopens it
# if it died, e.g. after the database restarted. Needs a valid sign-in to reopen.
tunnel_keeper() {
  while [[ -f $ENV_FILE ]]; do
    sleep 240
    [[ -f $ENV_FILE ]] || break
    { our_tunnel && tunnel_alive; } || (start_tunnel) || true # in a subshell: a failed reopen must not stop the keeper
  done
}

start_keeper() {
  stop_keeper
  nohup "$0" __tunnel-keeper >>"$STATE_DIR/tunnel.log" 2>&1 </dev/null &
  echo $! >"$STATE_DIR/keeper.pid"
  disown
}

stop_keeper() {
  [[ -f $STATE_DIR/keeper.pid ]] && kill "$(cat "$STATE_DIR/keeper.pid")" 2>/dev/null
  rm -f "$STATE_DIR/keeper.pid"
}

stop_tunnel() {
  if [[ -f $STATE_DIR/tunnel.pid ]]; then
    kill "$(cat "$STATE_DIR/tunnel.pid")" 2>/dev/null && echo "Closed the database tunnel"
    rm -f "$STATE_DIR/tunnel.pid"
  fi
  pkill -f "session-manager-plugin.*localPortNumber.*$DB_LOCAL_PORT" 2>/dev/null || true
}

# --- Local environment ---------------------------------------------------------------
# The same variables a job has, pointing at this laptop's mounts and tunnel. Written as
# KEY=value lines (readable only by you), which shells, R (readRenviron) and Julia can load.

ENV_FILE="$STATE_DIR/env"

write_env() {
  local secret
  secret=$(aws secretsmanager get-secret-value --secret-id "$(cfg db_secret_arn)" --query SecretString --output text)
  (
    umask 077
    python3 -c '
import json, os, sys
s = json.loads(sys.argv[1])
env = {
    "WORKSPACE": sys.argv[2], "SATELLITE": sys.argv[3], "DATA_BUCKET": sys.argv[4], "AWS_REGION": sys.argv[5],
    "DATASETS": sys.argv[7], "SATURN_R": sys.argv[8] + "/lib/saturn.R", "SATURN_JL": sys.argv[8] + "/lib/saturn.jl",
    "SATURN_PY": sys.argv[8] + "/lib/saturn.py",
    "MY_WORKSPACE": sys.argv[2] + "/" + sys.argv[9],
    # renv installs the packages of a project on this laptop, not into its folder in the
    # shared workspace (slow over the mount, and the job installs its own anyway).
    "RENV_PATHS_LIBRARY_ROOT": os.path.expanduser("~/.local/share/renv/library"),
    "DB_HOST": "127.0.0.1", "DB_PORT": sys.argv[6], "DB_USER": s["username"], "DB_PASSWORD": s["password"],
}
print("# Written by `saturn connect`, removed by `saturn disconnect`. Same names as inside a job.")
for k, v in env.items(): print(f"{k}={v}")' "$secret" "$WORKSPACE_DIR" "$SATELLITE_DIR" "$(cfg data_bucket)" \
      "$AWS_DEFAULT_REGION" "$DB_LOCAL_PORT" "$DATASETS_DIR" "$SATURN_HOME" "$(my_folder)" >"$ENV_FILE"
  )
  echo "Environment written to $ENV_FILE"
}

# Shell commands that set the variables, for: eval "$(saturn connect)".
env_exports() {
  python3 -c '
import shlex, sys
for line in open(sys.argv[1]):
    line = line.rstrip("\n")
    if line and not line.startswith("#"):
        k, v = line.split("=", 1)
        print(f"export {k}={shlex.quote(v)}")' "$ENV_FILE"
}

do_connect() {
  {
    do_mount
    mkdir -p "$WORKSPACE_DIR/$(my_folder)" && echo "Your folder: $WORKSPACE_DIR/$(my_folder)"
    start_tunnel
    write_env
    start_keeper
  } >&2
  if [[ -t 1 ]]; then
    echo "Connected. New terminals pick up the environment (see the README's one-line ~/.zshrc setup)."
    echo "For this terminal: eval \"\$(saturn connect)\""
  else
    env_exports # called as eval "$(saturn connect)"
  fi
}

do_disconnect() {
  stop_keeper
  stop_tunnel
  do_unmount
  rm -f "$ENV_FILE"
  echo "Disconnected"
}

do_status() {
  mount | grep -E " on ($WORKSPACE_DIR|$SATELLITE_DIR|$DATASETS_DIR) " || echo "workspace, satellite and datasets: not mounted"
  if our_tunnel && tunnel_alive; then
    echo "database: tunnel open on 127.0.0.1:$DB_LOCAL_PORT"
  elif our_tunnel; then
    echo "database: tunnel not answering (run saturn connect to reopen it)"
  elif port_open "$DB_LOCAL_PORT"; then
    echo "database: no tunnel (port $DB_LOCAL_PORT is used by something else; connect with DB_LOCAL_PORT=13306)"
  else
    echo "database: no tunnel"
  fi
  if [[ -f $ENV_FILE ]]; then echo "environment: $ENV_FILE"; else echo "environment: not written"; fi
}

case "$1" in
login) shift; do_login "$@" ;;
connect) do_connect ;;
disconnect) do_disconnect ;;
status) do_status ;;
run) shift; run_job "$@" ;;
logs) follow "${2:?usage: saturn logs <task-id>}" ;;
stop) aws ecs stop-task --cluster "$(cfg cluster)" --task "${2:?usage: saturn stop <task-id>}" \
  --reason "stopped by $(aws sts get-caller-identity --query Arn --output text | sed 's|.*/||') with saturn" \
  --query 'task.lastStatus' --output text ;;
list) aws ecs list-tasks --cluster "$(cfg cluster)" --query 'taskArns[]' --output text | tr '\t' '\n' | sed 's|.*/||' ;;
cost) record_cost "${2:?usage: saturn cost <task-id>}" ;;
costs) show_costs ;;
docs) # the guide in this checkout, so it matches this version of saturn
  if command -v open >/dev/null; then open "$SATURN_HOME/docs/guide.html"; else xdg-open "$SATURN_HOME/docs/guide.html"; fi ;;
__tunnel-keeper) tunnel_keeper ;;
esac
